---
import { CHAPTER, CREATOR, CREDIT_LINE, PUBLIC_TITLE, TAGLINE } from '@blr/content';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const playUrl = `${base}play/`;
const description =
  'An original open-world browser game set in a stylised Bengaluru. Drive autos, dodge traffic and explore Koramangala, free in your browser.';
const features = [
  ['Namma roads', 'Real street layouts from OpenStreetMap, rebuilt as a stylised, streamed city.'],
  ['The auto is the hero', 'Three wheels, one meter, and handling you will learn to love.'],
  ['A living city', 'Traffic that honks, rain that floods the underpass, and a 6 PM you will fear.'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{PUBLIC_TITLE} — Bengaluru open-world browser game</title>
    <meta name="description" content={description} />
    <meta name="author" content={CREATOR.name} />
    <meta name="theme-color" content="#0d0f14" />
    <meta property="og:title" content={`${PUBLIC_TITLE} — Bengaluru open-world browser game`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <main>
      <p class="eyebrow">{CHAPTER} · In development</p>
      <h1>{PUBLIC_TITLE}</h1>
      <p class="lede">{TAGLINE}</p>
      <a class="cta" href={playUrl}>Play the pre-alpha</a>

      <ul>
        {
          features.map(([title, body]) => (
            <li>
              <h2>{title}</h2>
              <p>{body}</p>
            </li>
          ))
        }
      </ul>
    </main>
    <footer>
      <p>
        {CREDIT_LINE} — {CREATOR.role}, {CREATOR.city} ·
        <a href={CREATOR.githubUrl} rel="noreferrer">@{CREATOR.githubHandle}</a>
      </p>
    </footer>
  </body>
</html>

<style>
  :global(html) {
    background: #0d0f14;
    color: #f2ede2;
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      sans-serif;
  }
  :global(body) {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: radial-gradient(120% 80% at 80% 0%, #2a2413 0%, #0d0f14 60%);
  }
  main {
    flex: 1;
    width: min(100% - 32px, 960px);
    margin: 0 auto;
    padding: 12vh 0 64px;
  }
  .eyebrow {
    color: #f5c518;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }
  h1 {
    margin: 16px 0 0;
    font-family: 'Avenir Next Condensed', 'Arial Narrow', 'Roboto Condensed', system-ui, sans-serif;
    font-size: clamp(56px, 13vw, 132px);
    font-style: italic;
    font-weight: 900;
    line-height: 0.9;
    text-transform: uppercase;
  }
  .lede {
    max-width: 34ch;
    margin: 24px 0 32px;
    font-size: 20px;
    color: #f2ede2cc;
  }
  .cta {
    display: inline-block;
    padding: 14px 32px;
    border-radius: 2px;
    background: #f5c518;
    color: #0d0f14;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .cta:hover {
    filter: brightness(1.1);
  }
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
    margin: 72px 0 0;
    padding: 0;
    list-style: none;
  }
  li {
    padding-top: 16px;
    border-top: 1px solid #f2ede233;
  }
  h2 {
    margin: 0 0 8px;
    font-size: 16px;
  }
  li p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: #f2ede2b3;
  }
  footer {
    width: min(100% - 32px, 960px);
    margin: 0 auto;
    padding: 24px 0;
    font-size: 13px;
    color: #f2ede299;
  }
  footer a {
    color: inherit;
  }
</style>
